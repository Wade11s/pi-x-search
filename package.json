{
  "name": "pi-x-search",
  "version": "0.4.0",
  "description": "X search for Pi using the official xAI Responses API and Pi's saved xAI credentials.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "xai",
    "x-search"
  ],
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts",
    "smoke": "node --import tsx scripts/smoke.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3"
  }
}
